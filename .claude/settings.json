{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(avdmanager:*)",
      "Bash(sdkmanager:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git remote -v:*)",
      "Bash(rg:*)",
      "Bash(bash .claude/kit/detect-stack.sh:*)",
      "Bash(python3 .claude/kit/scaffold.py:*)",
      "Bash(bash .claude/kit/gradle-check.sh:*)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/google-services.json)",
      "Read(./.env*)",
      "Read(./.claude-plugin-config.json)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/kit/format-edit.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/kit/compact-checkpoint.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/kit/compact-checkpoint.py\" --restore"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "android-emulator-qa@android-claude": false,
    "android-emulator-qa@android-claude-max": false,
    "android-emulator-qa@android-claude-max-hybrid": false,
    "android-emulator-qa@android-hybrid": false,
    "android-emulator-qa@android-local": false,
    "android-emulator-qa@android-stock": false,
    "android-kmp-playbook@android-claude": false,
    "android-kmp-playbook@android-claude-max": false,
    "android-kmp-playbook@android-claude-max-hybrid": true,
    "android-kmp-playbook@android-hybrid": false,
    "android-kmp-playbook@android-local": false,
