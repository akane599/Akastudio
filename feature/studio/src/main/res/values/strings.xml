    <!-- Errors (IngestionError and curation) -->
    <string name="error_ingestion_zip_slip">This archive contains files that point outside it, so it was not opened.</string>
    <string name="error_ingestion_zip_bomb">This archive expands to an unsafe size, so it was not opened.</string>
    <string name="error_ingestion_limit_exceeded">This archive is larger than AkaStudio can handle at once. Try a smaller set of photos.</string>
    <string name="error_ingestion_invalid_archive">This file isn\'t a readable .zip archive.</string>
    <string name="error_ingestion_insufficient_storage">Not enough free space: %1$s needed, %2$s available.</string>
    <string name="error_ingestion_io">A photo couldn\'t be read. Check the source and try again.</string>
    <string name="error_no_usable_photos">None of these photos could be used. Try photos that are sharp and well exposed.</string>

    <!-- Curator note (CuratorNoteFormatter). Argument order is fixed; translations may reorder. -->
    <!-- %1$s photos phrase, %2$s frames phrase, %3$s scales phrase, %4$s scale list, %5$s tone, %6$s percent -->
    <string name="note_collage">Chosen from %1$s: %2$s %3$s (%4$s) in %5$s tones — %6$s harmony.</string>
    <!-- %1$s photos phrase, %2$s frames phrase, %3$s tone, %4$s percent -->
    <string name="note_collage_no_scales">Chosen from %1$s: %2$s in %3$s tones — %4$s harmony.</string>
    <!-- %1$s photos phrase, %2$s tone, %3$s percent -->
    <string name="note_hero">Chosen from %1$s in %2$s tones — this frame stands alone (score %3$s).</string>
    <string name="note_percent">%1$d%%</string>
    <string name="note_list_separator">", "</string>
    <plurals name="note_photos">
        <item quantity="one">%1$d photo</item>
        <item quantity="other">%1$d photos</item>
    </plurals>
    <plurals name="note_frames">
        <item quantity="one">%1$d frame</item>
        <item quantity="other">%1$d frames</item>
    </plurals>
    <!-- %1$s is the count from note_count_words -->
    <plurals name="note_scales">
        <item quantity="one">across %1$s scale</item>
        <item quantity="other">across %1$s scales</item>
    </plurals>
    <string-array name="note_count_words">
        <item>one</item>
        <item>two</item>
        <item>three</item>
        <item>four</item>
    </string-array>
    <string name="note_tone_golden_warm">warm golden-hour</string>
    <string name="note_tone_neutral">neutral</string>
    <string name="note_tone_cool_blue">cool blue</string>
    <string name="note_tone_night_tungsten">tungsten night</string>
</resources>
