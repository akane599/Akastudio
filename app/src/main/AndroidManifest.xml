<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- No media permissions: photos come from the system photo picker (images only), archives from the document picker. -->
    <!-- No network: everything runs on-device. MediaPipe's data-transport telemetry (CCT backend) brings INTERNET and
         ACCESS_NETWORK_STATE; its backend is removed below so events are dropped instead of queued for upload.
         `check<Variant>NoInternetPermission` (app/build.gradle.kts) fails the build if INTERNET comes back. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Dormant transitive plumbing: WorkManager (never initialised, see the provider below) wants WAKE_LOCK and
         RECEIVE_BOOT_COMPLETED; LiteRT / Play Asset Delivery want the dataSync foreground service for AI-pack downloads,
         whose service ships disabled. Models load from APK assets, so none of it runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <application
        android:name=".AkaStudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AkaStudio">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- WorkManager arrives only transitively (LiteRT -> play:ai-delivery -> play:asset-delivery -> work-runtime) and
             nothing here schedules work: models load from APK assets, not AI packs. Skip its startup initializer so
             launch never opens WorkManager's Room database.
             MissingClass is a lint false positive: startup-runtime is on the runtime classpath, only transitively. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- MediaPipe's TaskRunner always builds a data-transport logger, so the runtime stays (excluding it crashes task
             creation). With no backend registered, the scheduler rejects each event instead of storing it.
             MissingClass is the same transitive-runtime-classpath false positive as on the startup provider. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>
</manifest>
